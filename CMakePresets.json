      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_SANITIZER": "memory"
      }
    },
    {
      "name": "linux-clang-fuzz",
