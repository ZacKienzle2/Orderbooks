      "displayName": "Linux Clang source-based coverage of the test suite",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "LOB_COVERAGE": "ON",
        "LOB_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "linux-clang-fuzz-coverage",
      "displayName": "Linux Clang source-based coverage of the fuzz corpora",
      "inherits": "linux-clang-fuzz",
      "cacheVariables": {
        "LOB_COVERAGE": "ON",
        "LOB_SANITIZER": ""
      }
    },
    {
      "name": "linux-clang-pgo-generate",
      "displayName": "Linux Clang profile training over the profiler workloads",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_PGO": "generate",
        "LOB_BUILD_TESTS": "OFF",
        "LOB_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "linux-clang-pgo",
      "displayName": "Linux Clang Release built from the trained profile",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_PGO": "use"
      }
    },
    {
      "name": "_conda",
      "hidden": true,
      "description": "The compiler, linker and archiver of workflow/envs/toolchain.yaml, whose clang activation packages set CXX to the conda-forge compiler and its sysroot (conda-forge FAQ). That clang lacks the LLVMgold.so plugin the default linker would load for ThinLTO, and lld is a linker of the Clang ThinLTO documentation, so the preset selects it through CMAKE_LINKER_TYPE, which try_compile also reads. CMake looks for llvm-ar and llvm-ranlib under the x86_64-conda-linux-gnu- prefix of the compiler name (Modules/Compiler/Clang-FindBinUtils.cmake), and llvm-tools installs them without it, so the preset names the ones in CONDA_PREFIX, the variable the activation scripts build their own paths from. The activation also exports CXXFLAGS with flags of its own, such as -O2, -march=nocona and -fno-plt, which CMake would take into CMAKE_CXX_FLAGS on the first configure, so the preset sets that variable empty and the build takes the project flags alone, as the Linux presets do. LDFLAGS stays, since its rpath binds the environment's libstdc++.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{CXX}",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_CXX_FLAGS": "",
        "CMAKE_CXX_COMPILER_AR": "$env{CONDA_PREFIX}/bin/llvm-ar",
        "CMAKE_CXX_COMPILER_RANLIB": "$env{CONDA_PREFIX}/bin/llvm-ranlib"
      }
    },
    {
      "name": "conda-clang-rel",
      "inherits": ["_conda", "linux-clang-rel"],
      "displayName": "Linux Clang Release in the conda toolchain of the workflow",
      "description": "linux-clang-rel built with the conda toolchain of the workflow."
    },
    {
      "name": "conda-clang-rel-no-frontend-flags",
      "inherits": "conda-clang-rel",
      "displayName": "conda-clang-rel without the front end flags",
      "description": "conda-clang-rel with -fno-plt, -falign-functions=64 and -falign-loops=32 of cmake/CompilerFlags.cmake left out, the other side of the comparison that decides whether they stay. check_compiler_flag checks once and keeps its result in the cache variable it names (CheckCompilerFlag module), so a false result set here leaves the flag out without a change to the project.",
      "cacheVariables": {
        "LOB_HAVE_CXX__fno_plt": "OFF",
        "LOB_HAVE_CXX__falign_functions_64": "OFF",
        "LOB_HAVE_CXX__falign_loops_32": "OFF"
      }
    },
    {
      "name": "conda-clang-pgo-generate",
      "inherits": ["_conda", "linux-clang-pgo-generate"],
      "displayName": "Linux Clang profile training in the conda toolchain of the workflow",
      "description": "linux-clang-pgo-generate built with the conda toolchain of the workflow, which supplies the llvm-profdata the merge finds beside the compiler."
    },
    {
      "name": "conda-clang-pgo",
      "inherits": ["_conda", "linux-clang-pgo"],
      "displayName": "Linux Clang Release from the trained profile in the conda toolchain of the workflow",
      "description": "linux-clang-pgo built with the conda toolchain of the workflow, from the profile conda-clang-pgo-generate merges."
    }
  ],
