        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Apple Clang Debug",
      "inherits": "_macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
