{
  "version": 6,
  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON"
      }
    },
    {
      "name": "_linux",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "_macos",
      "hidden": true,
      "inherits": "_base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "linux-clang-rel",
      "displayName": "Linux Clang Release",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "linux-clang-relwithdebinfo",
      "displayName": "Linux Clang RelWithDebInfo",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc-rel",
      "displayName": "Linux GCC Release",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux Clang AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_SANITIZER": "address,undefined"
      }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux Clang ThreadSanitizer",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_SANITIZER": "thread"
      }
    },
    {
      "name": "linux-clang-msan",
      "displayName": "Linux Clang MemorySanitizer",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_SANITIZER": "memory"
      }
    },
    {
      "name": "linux-clang-fuzz",
      "displayName": "Linux Clang libFuzzer",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_BUILD_FUZZ": "ON",
        "LOB_BUILD_TESTS": "OFF",
        "LOB_BUILD_BENCH": "OFF",
        "LOB_SANITIZER": "address,undefined"
      }
    },
    {
      "name": "macos-clang-dev",
      "displayName": "macOS Apple Clang Dev",
      "inherits": "_macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-clang-rel",
      "displayName": "macOS Apple Clang Release",
      "inherits": "_macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "macOS Apple Clang Debug",
      "inherits": "_macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-coverage",
      "displayName": "Linux Clang source-based coverage of the test suite",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "LOB_COVERAGE": "ON",
        "LOB_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "linux-clang-fuzz-coverage",
      "displayName": "Linux Clang source-based coverage of the fuzz corpora",
      "inherits": "linux-clang-fuzz",
      "cacheVariables": {
        "LOB_COVERAGE": "ON",
        "LOB_SANITIZER": ""
      }
    },
    {
      "name": "linux-clang-pgo-generate",
      "displayName": "Linux Clang profile training over the profiler workloads",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_PGO": "generate",
        "LOB_BUILD_TESTS": "OFF",
        "LOB_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "linux-clang-pgo",
      "displayName": "Linux Clang Release built from the trained profile",
      "inherits": "_linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_PGO": "use"
      }
    }
  ],
  "buildPresets": [
