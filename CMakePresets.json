      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "LOB_BUILD_FUZZ": "ON",
        "LOB_BUILD_TESTS": "OFF",
        "LOB_BUILD_BENCH": "OFF",
        "LOB_SANITIZER": "address,undefined"
      }
    },
    {
      "name": "macos-clang-dev",
      "displayName": "macOS Apple Clang Dev",
