root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# CommonMark sets list-continuation indentation, so the width inherited
# from [*] does not apply. "unset" is the specification's own way to undo an
# inherited pair.
indent_size = unset
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,toml}]
# A pinned action is a forty-character digest plus the tag it stands for, and
# the reference carrying it does not fit a line limit meant for prose or code.
# "unset" is the specification's own way to undo an inherited pair.
max_line_length = unset
indent_size = 2

[Makefile]
indent_style = tab

[*.{js,cjs,mjs,ts,tsx,jsx}]
indent_size = 2

# clang-format owns the layout of these and aligns continuation lines to the
# construct rather than to a multiple of the indent, and cmake-format does the
# same for CMake. editorconfig-checker reads indent_size as a rule, so the
# formatter's own output failed it on 29 lines of one tree. "unset" leaves
# the width to the formatter and keeps the rest of the section.
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,cu,cuh}]
indent_size = unset

[{CMakeLists.txt,*.cmake}]
indent_size = unset

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.go]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
