root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# CommonMark sets list-continuation indentation, so the width inherited
# from [*] does not apply. "unset" is the specification's own way to undo an
# inherited pair.
indent_size = unset
trim_trailing_whitespace = false

# CITATION.cff is YAML by the Citation File Format specification, and
# clang-format, clang-tidy and clangd keep their configuration in YAML files
# named without an extension, which prettier formats as YAML by name.
[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[.clang-*]
indent_size = 2

# max_line_length is set only where a formatter reads it. prettier takes its
# print width from here for these languages; ruff, clang-format and
# cmake-format carry their own widths; and a linter reading a width under [*]
# reported generated .gitignore headers, data files and a Doxyfile that no
# formatter will ever wrap.
[*.{js,cjs,mjs,ts,tsx,jsx,css,scss,html}]
max_line_length = 120

[Makefile]
indent_style = tab

[*.{js,cjs,mjs,ts,tsx,jsx}]
indent_size = 2

[*.{css,scss,html}]
indent_size = 2

# clang-format owns the layout of these and aligns continuation lines to the
# construct rather than to a multiple of the indent, and cmake-format does the
# same for CMake. editorconfig-checker reads indent_size as a rule, so the
# formatter's own output failed it on 29 lines of one tree. "unset" leaves
# the width to the formatter and keeps the rest of the section.
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,cu,cuh}]
indent_size = unset

[{CMakeLists.txt,*.cmake}]
indent_size = unset

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.go]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
