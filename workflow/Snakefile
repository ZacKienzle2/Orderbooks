# The measurement workflow of Orderbooks. It builds each preset in the toolchain environment of
# workflow/envs and classifies each profiler workload with the top-down method (Yasin, ISPASS 2014)
# before any remedy is measured, since the method drills only into the categories it flags (section
# 3). Every setting comes from config/config.yaml.

import glob
import os
import re

configfile: "config/config.yaml"


# A preset is one that config/config.yaml configures, so build/{preset} can't also match the layout
# experiment's build/layout-{preset}-{seed}, and a seed or a repetition is a number.
wildcard_constraints:
    preset="|".join(map(re.escape, config["conan"])),
    seed=r"\d+",
    rep=r"\d+",


def topdown_results(wildcards):
    return [
        path
        for preset in config["presets"]
        for path in expand(
            "results/topdown/{preset}/{workload}/{metric}.json",
            preset=preset,
            workload=workloads(preset),
            metric=config["metrics"],
        )
    ]


def latency_results(wildcards):
    return expand(
        "results/latency/{preset}/{load}/{rep}.txt",
        preset=config["presets"],
        load=config["loads"],
        rep=range(config["repeats"]),
    )


def sql_list(paths):
    return "[" + ", ".join(f"'{path}'" for path in paths) + "]"


rule all:
    input:
        "results/summary/topdown.csv",
        "results/summary/latency.csv",


SOURCES = [
    path
    for tree in ("include", "src", "apps", "bench", "tests", "fuzz", "cmake")
    for path in glob.glob(f"{tree}/**/*", recursive=True)
    if os.path.isfile(path)
] + ["CMakeLists.txt", "conanfile.py", "conan.lock", "workflow/conan/conda"]


# The arguments of a conan command for a preset of config/config.yaml. The Conan package cache is not
# concurrent, and parallel tasks need separate caches (Conan guidelines), so every rule that runs
# conan takes the one unit of the conan resource the workflow profile declares, which Snakemake
# counts across all jobs in cluster execution ("Resources and Remote Execution"). conan profile
# detect --force writes the default profile the conda profile includes from the environment's
# compilers each time. The const entry of build_folder_vars names the build folder
# build/<preset>/Release and its presets conan-<preset>-release after the preset (cmake_layout
# reference), and the recipe's options name nothing here. The & pattern applies a conf to the
# consumer conanfile alone ("Profile patterns"), so no dependency built into the shared cache takes
# it, and conf is not part of a package_id.
def conan(preset, command, folder=None):
    options = " ".join(f'-o "&:{option}"' for option in config["conan"][preset])
    return (
        f"conan {command} . -pr:h workflow/conan/conda -pr:b default --build=missing {options}"
        f" -c \"&:tools.cmake.cmake_layout:build_folder_vars=['const.{folder or preset}']\""
    )


# The training build runs every profiler workload instrumented and merges the counts into the
# profile a LOB_PGO=use build reads, the default LOB_PGO_PROFILE of CMakeLists.txt. ADR-0056 trained
# on the gateway and the load generator too, and kept the profile-guided build off.
rule pgo_profile:
    input:
        SOURCES,
    output:
        "artifacts/pgo/train.profdata",
    log:
        "logs/pgo/train.log",
    conda:
        "envs/toolchain.yaml"
    threads: workflow.cores
    resources:
        conan=1,
    params:
        conan=conan(config["pgo"]["train"], "build"),
    shell:
        "conan profile detect --force > {log} 2>&1"
        " && {params.conan} -c tools.build:jobs={threads} >> {log} 2>&1"


# conan build installs the dependencies, configures, builds and runs the tests (conanfile.py), so a
# build that fails its tests on Friday stops here. tools.build:jobs sets the parallelism of the build
# and of ctest to the job's threads rather than the node's CPUs. A preset that reads the profile
# waits for the training.
rule build:
    input:
        lambda wildcards: SOURCES
        + (rules.pgo_profile.output if wildcards.preset in config["pgo"]["use"] else []),
    output:
        profile="build/{preset}/Release/apps/profile/lob_profile",
        loadgen="build/{preset}/Release/apps/loadgen/lob_loadgen",
    log:
        "logs/build/{preset}.log",
    conda:
        "envs/toolchain.yaml"
    threads: workflow.cores
    resources:
        conan=1,
    params:
        conan=lambda wildcards: conan(wildcards.preset, "build"),
    shell:
        "conan profile detect --force > {log} 2>&1"
        " && {params.conan} -c tools.build:jobs={threads} >> {log} 2>&1"


# The profiler lists its workloads, so a workload added there is measured without a second list
# here, as the profile training tests read the same listing.
checkpoint workloads:
    input:
        rules.build.output.profile,
    output:
        "results/workloads/{preset}.txt",
    log:
        "logs/workloads/{preset}.log",
    conda:
        "envs/toolchain.yaml"
    shell:
        "{input} --list > {output} 2> {log}"


def workloads(preset):
    with open(checkpoints.workloads.get(preset=preset).output[0]) as listing:
        return [line.split()[0] for line in listing if line.strip()]


# Top-level slots of each workload, one metric of config/config.yaml a process.
# setarch -R turns off address space randomisation for the process and env -i fixes its environment,
# which brought retired instruction counts from a variation of 1.07 per cent to below 0.002 per cent
# (Weaver and McKee, IISWC 2008, sections 4.2.1 and 5). perf stat -r repeats the process and -j writes
# JSON, the tool's own output format. JSON output carries each metric's threshold, and perf adds the
# events a threshold expression needs, two more general events for retiring, unless
# --metric-no-threshold is given (perf stat -h). A threshold the metric's own events decide is
# still reported.
rule topdown:
    input:
        rules.build.output.profile,
    output:
        "results/topdown/{preset}/{workload}/{metric}.json",
    log:
        "logs/topdown/{preset}/{workload}/{metric}.log",
    conda:
        "envs/toolchain.yaml"
    params:
        repeats=config["repeats"],
    shell:
        'setarch -R env -i PATH="$PATH" perf stat -j -r {params.repeats}'
        " --metric-no-threshold -M {wildcards.metric}"
        " -o {output} -- {input} --workload {wildcards.workload} > {log} 2>&1"


# End-to-end latency of the load generator, closed with one pair in flight at load 0 and open at the
# other loads (Schroeder, Wierman and Harchol-Balter, NSDI 2006, section 5.1). numactl binds the
# process and its memory to node 0, because threads and memory spread over two nodes inflated the
# tail (Tales of the tail, SoCC 2014, section 4.5), and the pinned workers take the first CPUs of
# that node. Each repetition draws its arrivals from a seed of its own. cpupower records the
# frequency governor and the idle states, which a job cannot change and which moved the tail too
# (section 4.6).
rule latency:
    input:
        rules.build.output.loadgen,
    output:
        latency="results/latency/{preset}/{load}/{rep}.txt",
        host="results/latency/{preset}/{load}/{rep}.host.txt",
    log:
        "logs/latency/{preset}/{load}/{rep}.log",
    conda:
        "envs/toolchain.yaml"
    threads: workflow.cores
    params:
        load=lambda wildcards: f"--load {wildcards.load}" if float(wildcards.load) > 0 else "",
    shell:
        "cpupower frequency-info > {output.host} 2> {log}"
        " && cpupower idle-info >> {output.host} 2>> {log}"
        ' && setarch -R env -i PATH="$PATH" numactl --cpunodebind=0 --membind=0'
        " {input} --pin {params.load} --seed {wildcards.rep} > {output.latency} 2>> {log}"


# DuckDB summarises the results in SQL, each query reading the files its input lists through the
# variable files, so a result of a preset or a load that config/config.yaml no longer names stays out.
rule summary:
    input:
        topdown=topdown_results,
        latency=latency_results,
        topdown_sql="workflow/sql/topdown.sql",
        latency_sql="workflow/sql/latency.sql",
    output:
        topdown="results/summary/topdown.csv",
        latency="results/summary/latency.csv",
    log:
        "logs/summary.log",
    conda:
        "envs/summary.yaml"
    params:
        topdown=lambda wildcards, input: sql_list(input.topdown),
        latency=lambda wildcards, input: sql_list(input.latency),
    shell:
        'duckdb -csv -c "SET VARIABLE files = {params.topdown}" -c ".read {input.topdown_sql}"'
        " > {output.topdown} 2> {log}"
        ' && duckdb -csv -c "SET VARIABLE files = {params.latency}" -c ".read {input.latency_sql}"'
        " > {output.latency} 2>> {log}"


# The layout experiment repeats each preset of config/config.yaml's layout at the level of the
# binary. Link order alone moved two SPEC programs by 4 and 2.6 per cent (Kalibera and Jones, ISMM
# 2013, section 8.2), so one binary a side leaves the effect of a flag confounded with the layout it
# happened to get. lld's --randomize-section-padding inserts random padding between input sections
# and at the start of each segment, to control measurement bias in A/B experiments (lld 20 release
# notes). Function sections make each function an input section, so the padding moves functions
# relative to each other as well as the segment. Run it as the target `layout`.
rule layout:
    input:
        expand(
            "results/summary/layout/{load}/{metric}.txt",
            load=config["layout"]["loads"],
            metric=config["layout"]["metrics"],
        ),
        "results/summary/layout/nodes.csv",


# Each binary gets a Conan build folder of its own, since the presets Conan writes name the toolchain
# file relative to the build folder (CMakeToolchain absolute_paths). The dict update of
# extra_variables replaces the conda profile's empty CMAKE_CXX_FLAGS, which the toolchain sets as a
# normal variable that a -D cache entry can't override. The installs take the conan resource, and
# the builds that follow run in parallel.
rule layout_install:
    input:
        SOURCES,
    output:
        "build/layout-{preset}-{seed}/Release/generators/CMakePresets.json",
    log:
        "logs/layout/install/{preset}/{seed}.log",
    conda:
        "envs/toolchain.yaml"
    threads: workflow.cores
    resources:
        conan=1,
    params:
        conan=lambda wildcards: conan(
            wildcards.preset, "install", f"layout-{wildcards.preset}-{wildcards.seed}"
        ),
    shell:
        "conan profile detect --force > {log} 2>&1"
        " && {params.conan} -c tools.build:jobs={threads}"
        " -c \"&:tools.cmake.cmaketoolchain:extra_variables*={{'CMAKE_CXX_FLAGS': '-ffunction-sections'}}\""
        " >> {log} 2>&1"


# The linker flags keep the LDFLAGS the conda activation exports, whose rpath binds the environment's
# libstdc++, and CMake reads a -D cache entry for them since the toolchain leaves them alone.
rule layout_build:
    input:
        rules.layout_install.output,
    output:
        "build/layout-{preset}-{seed}/Release/apps/loadgen/lob_loadgen",
    log:
        "logs/layout/build/{preset}/{seed}.log",
    conda:
        "envs/toolchain.yaml"
    threads: workflow.cores
    params:
        tree=lambda wildcards: f"build/layout-{wildcards.preset}-{wildcards.seed}/Release",
    shell:
        "cmake --presets-file {input} --preset conan-layout-{wildcards.preset}-{wildcards.seed}-release"
        ' --fresh -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS -ffunction-sections'
        ' -Wl,--randomize-section-padding={wildcards.seed}" > {log} 2>&1'
        " && cmake --build {params.tree} --target lob_loadgen >> {log} 2>&1"


# Each binary runs as the latency rule runs its binary, and the runs of one binary and load go to
# the Slurm job of one group. The first line of a result records the node as node=, the key=value
# form of the load generator's own lines, for layout_nodes.
rule layout_latency:
    input:
        rules.layout_build.output,
    output:
        "results/layout/{preset}/{seed}/{load}/{rep}.txt",
    log:
        "logs/layout/latency/{preset}/{seed}/{load}/{rep}.log",
    conda:
        "envs/toolchain.yaml"
    group:
        "layout"
    threads: workflow.cores
    params:
        load=lambda wildcards: f"--load {wildcards.load}" if float(wildcards.load) > 0 else "",
    shell:
        "echo node=$(uname -n) > {output}"
        ' && setarch -R env -i PATH="$PATH" numactl --cpunodebind=0 --membind=0'
        " {input} --pin {params.load} --seed {wildcards.rep} >> {output} 2> {log}"


# One bench_ci values object a binary, load and percentile, which bench_ci reads as one run of the
# top level.
rule layout_values:
    input:
        runs=lambda wildcards: expand(
            "results/layout/{preset}/{seed}/{load}/{rep}.txt",
            rep=range(config["repeats"]),
            allow_missing=True,
        ),
        sql="workflow/sql/layout_values.sql",
    output:
        "results/layout/bench_ci/{load}/{metric}/{preset}-{seed}.json",
    log:
        "logs/layout/values/{load}/{metric}/{preset}-{seed}.log",
    conda:
        "envs/summary.yaml"
    group:
        "layout"
    params:
        files=lambda wildcards, input: sql_list(input.runs),
    shell:
        'duckdb -jsonlines -c "SET VARIABLE files = {params.files}"'
        " -c \"SET VARIABLE system = '{wildcards.preset}'\""
        " -c \"SET VARIABLE benchmark = '{wildcards.metric}'\""
        " -c \"SET VARIABLE pattern = '{wildcards.metric}=([0-9]+)'\""
        ' -c ".read {input.sql}" > {output} 2> {log}'


# bench_ci reports each preset's mean with its interval across binaries and the Fieller interval
# of the ratio of each preset to the first in name order (Kalibera and Jones, ISMM 2013, equations
# 4 and 5).
rule layout_report:
    input:
        lambda wildcards: expand(
            "results/layout/bench_ci/{load}/{metric}/{preset}-{seed}.json",
            load=wildcards.load,
            metric=wildcards.metric,
            preset=config["layout"]["presets"],
            seed=range(1, config["layout"]["binaries"] + 1),
        ),
    output:
        "results/summary/layout/{load}/{metric}.txt",
    log:
        "logs/layout/report/{load}/{metric}.log",
    conda:
        "envs/analysis.yaml"
    params:
        directory=lambda wildcards: f"results/layout/bench_ci/{wildcards.load}/{wildcards.metric}",
    shell:
        "PYTHONPATH=src python -m orderbooks.bench_ci {params.directory} > {output} 2> {log}"


# Every run of a Slurm job shares its node, so the state of a node enters all of them together.
# DuckDB groups the runs by node, preset and load, with the median saturated rate and p50 of each
# group, and the variables keep out any run of a preset, load, seed or repetition that
# config/config.yaml no longer names.
rule layout_nodes:
    input:
        runs=expand(
            "results/layout/{preset}/{seed}/{load}/{rep}.txt",
            preset=config["layout"]["presets"],
            seed=range(1, config["layout"]["binaries"] + 1),
            load=config["layout"]["loads"],
            rep=range(config["repeats"]),
        ),
        sql="workflow/sql/layout_nodes.sql",
    output:
        "results/summary/layout/nodes.csv",
    log:
        "logs/layout/nodes.log",
    conda:
        "envs/summary.yaml"
    params:
        presets=sql_list(config["layout"]["presets"]),
        loads=sql_list(map(str, config["layout"]["loads"])),
        binaries=config["layout"]["binaries"],
        repeats=config["repeats"],
    shell:
        'duckdb -csv -c "SET VARIABLE presets = {params.presets}"'
        ' -c "SET VARIABLE loads = {params.loads}"'
        ' -c "SET VARIABLE binaries = {params.binaries}"'
        ' -c "SET VARIABLE repeats = {params.repeats}"'
        ' -c ".read {input.sql}" > {output} 2> {log}'
